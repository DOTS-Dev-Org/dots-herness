<UserControl x:Class="DotsHarness.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="168"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="{DynamicResource ChromeBackground}">
            <Button x:Name="BackButton" DockPanel.Dock="Top" Content="← Back to chats" Click="OnBack"
                    Margin="8,8,8,4" Padding="8,6" HorizontalContentAlignment="Left"/>
            <ListBox x:Name="Tabs" SelectionChanged="OnTab"
                     BorderThickness="0" Background="Transparent" Padding="8">
                <ListBoxItem x:Name="GeneralTab" Content="General" Tag="general" IsSelected="True"/>
                <ListBoxItem x:Name="ProvidersTab" Content="Providers" Tag="providers"/>
                <ListBoxItem x:Name="CustomTab" Content="Custom API" Tag="custom"/>
                <ListBoxItem x:Name="LocalTab" Content="Local models" Tag="local"/>
                <ListBoxItem x:Name="ShareTab" Content="Share" Tag="share"/>
                <ListBoxItem x:Name="TasksTab" Content="Tasks" Tag="tasks"/>
                <ListBoxItem x:Name="SkillsTab" Content="Skills" Tag="skills"/>
                <ListBoxItem x:Name="PluginsTab" Content="Plugins" Tag="plugins"/>
                <ListBoxItem x:Name="PromptTab" Content="Prompt" Tag="prompt"/>
            </ListBox>
        </DockPanel>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <ContentControl x:Name="Body"/>
        </ScrollViewer>
    </Grid>
</UserControl>
