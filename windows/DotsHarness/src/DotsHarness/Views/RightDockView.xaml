<UserControl x:Class="DotsHarness.Views.RightDockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DotsHarness.Views"
             Background="{DynamicResource WindowBackground}"
             Unloaded="OnUnloaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="↻" Width="30" Height="28"
                        Padding="0" Margin="6,8,0,8" Click="OnRefresh" ToolTip="Refresh panel"/>
                <TextBlock x:Name="WorkspaceLabel" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <TabItem x:Name="ReviewTab" Header="Review" Tag="review">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*" MinHeight="100"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="*" MinHeight="120"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock x:Name="BranchText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ReviewCount" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                    <ListBox x:Name="ReviewList" Grid.Row="1" SelectionChanged="OnReviewSelectionChanged"
                             Background="Transparent" BorderThickness="0"/>
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"
                                  Background="{DynamicResource BorderSubtle}"
                                  ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
                    <TextBox x:Name="ReviewDiff" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" Background="{DynamicResource PanelBackground}"
                             Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TerminalTab" Header="Terminal" Tag="terminal">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <Button x:Name="RestartTerminalButton" DockPanel.Dock="Right" Content="Restart"
                                Padding="10,3" Click="OnRestartTerminal"/>
                        <TextBlock x:Name="TerminalStatus" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                    <views:TerminalTextBox x:Name="TerminalBox" Grid.Row="1" IsReadOnly="True"
                                           Background="{DynamicResource PanelBackground}"
                                           Foreground="{DynamicResource TextPrimary}" BorderThickness="0"
                                           FontFamily="Consolas" FontSize="12"
                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="FilesTab" Header="Files" Tag="files">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="FilesFilter" Grid.Row="0" TextChanged="OnFilesFilterChanged"
                             Padding="8,4" ToolTip="Filter files"/>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="140"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="FilesList" Grid.Column="0" SelectionChanged="OnFileSelectionChanged"
                                 Background="Transparent" BorderThickness="0"/>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="{DynamicResource BorderSubtle}"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
                        <TextBox x:Name="FilePreview" Grid.Column="2" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" Background="{DynamicResource PanelBackground}"
                                 Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem x:Name="BrowserTab" Header="Browser" Tag="browser">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="BrowserBackButton" Content="‹" ToolTip="Back" Padding="9,3" Click="OnBrowserBack"/>
                        <Button Grid.Column="1" x:Name="BrowserForwardButton" Content="›" ToolTip="Forward" Padding="9,3" Margin="4,0,0,0" Click="OnBrowserForward"/>
                        <Button Grid.Column="2" x:Name="BrowserReloadButton" Content="↻" ToolTip="Reload" Padding="9,3" Margin="4,0,6,0" Click="OnBrowserReload"/>
                        <TextBox Grid.Column="3" x:Name="BrowserAddress" VerticalContentAlignment="Center"
                                 KeyDown="OnBrowserKeyDown" ToolTip="URL"/>
                        <Button Grid.Column="4" x:Name="OpenBrowserButton" Content="Go"
                                Padding="10,3" Margin="6,0,0,0" Click="OnOpenBrowser"/>
                        <Button Grid.Column="5" x:Name="BrowserExternalButton" Content="↗" ToolTip="Open externally"
                                Padding="9,3" Margin="4,0,0,0" Click="OnOpenBrowserExternally"/>
                    </Grid>
                    <Grid x:Name="BrowserHost" Grid.Row="1" Margin="0,6,0,0"/>
                    <TextBlock x:Name="BrowserStatus" Grid.Row="2" Margin="2,4,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
