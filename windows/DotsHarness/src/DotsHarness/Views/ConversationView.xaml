<UserControl x:Class="DotsHarness.Views.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DotsHarnessCore"
             xmlns:views="clr-namespace:DotsHarness.Views"
             AllowDrop="True"
             PreviewDragOver="OnDragOver"
             DragLeave="OnDragLeave"
             PreviewDrop="OnDrop"
             Background="{DynamicResource PanelBackground}">
    <UserControl.Resources>
        <Style x:Key="ComposerBannerStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="20,14,20,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ToggleButton x:Name="CacheUsageButton" Content="Context" Margin="0,0,8,0" Padding="10,4" Visibility="Collapsed"
                              Checked="OnCacheUsageOpened"/>
                <Popup PlacementTarget="{Binding ElementName=CacheUsageButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=CacheUsageButton, Mode=TwoWay}">
                    <Border Width="340" Padding="14" CornerRadius="14" Background="{DynamicResource ChromeBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <StackPanel Width="320">
                            <TextBlock x:Name="ContextUsageSummary" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <ProgressBar x:Name="ContextUsageProgress" Minimum="0" Maximum="1" Height="5"
                                         Margin="0,8,0,8" Visibility="Collapsed"/>
                            <TextBlock x:Name="ContextUsageBreakdown" Margin="0,0,0,8" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock x:Name="CacheUsageDetails" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Border>
                </Popup>
                <Button x:Name="TerminalButton" Content="Terminal" Padding="12,4"
                        Click="OnTerminal"/>
                <ToggleButton x:Name="ModelPicker" Margin="8,0,0,0" Padding="12,4" ToolTip="Model">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ModelPickerName" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ModelPickerEffort" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="⌄" Margin="6,0,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="ModelPopup" PlacementTarget="{Binding ElementName=ModelPicker}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True"
                       IsOpen="{Binding IsChecked, ElementName=ModelPicker, Mode=TwoWay}"
                       Opened="OnModelPopupOpened">
                    <Border Width="316" Padding="8" CornerRadius="14" Background="{DynamicResource ChromeBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <StackPanel>
                            <Border x:Name="EffortCard" CornerRadius="12" Padding="10" Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="EffortTitleButton" Grid.Column="1" HorizontalAlignment="Center" Padding="0"
                                                Background="Transparent" BorderThickness="0" Click="OnShowModels">
                                            <StackPanel>
                                                <TextBlock x:Name="EffortTitle" FontSize="15" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="EffortModelName" FontSize="11" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="EffortResetButton" Grid.Column="2" Content="↺" Padding="4,0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource TextSecondary}" Click="OnEffortReset"/>
                                    </Grid>
                                    <Canvas x:Name="EffortTrack" Height="30" Margin="0,10,0,0" Background="Transparent"
                                            MouseLeftButtonDown="OnEffortPointer" MouseMove="OnEffortPointer"
                                            SizeChanged="OnEffortTrackSized"/>
                                    <Button x:Name="UsageModeButton" Margin="0,8,0,0" Padding="8,3"
                                            HorizontalAlignment="Center" Click="OnUsageMode"/>
                                    <Button x:Name="FastModeButton" Margin="0,6,0,0" Padding="8,3" Visibility="Collapsed"
                                            HorizontalAlignment="Center" Click="OnFastMode"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="ModelListPanel" Visibility="Collapsed">
                                <Button x:Name="ModelListBack" HorizontalAlignment="Left" Padding="10,4" Background="Transparent"
                                        BorderThickness="0" Click="OnHideModels">
                                    <TextBlock x:Name="ModelListHeader" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                                <ListBox x:Name="ModelList" MaxHeight="340" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextPrimary}"
                                         SelectionChanged="OnModelChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Popup>
                <Image x:Name="ComposerLoadingAnimation" Width="20" Height="20" Margin="0,0,2,0"
                       Visibility="Collapsed" Stretch="Uniform" IsHitTestVisible="False"/>
                <Button x:Name="StopButton" Content="Stop" Margin="8,0,0,0" Padding="12,4"
                        Click="OnStop" Visibility="Collapsed"/>
                <Button x:Name="CancelPlanButton" Content="Cancel plan" Margin="8,0,0,0" Padding="12,4"
                        Click="OnCancelPlanFromComposer" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackground}" Padding="16">
            <StackPanel>
                <views:SlotHost x:Name="ComposerAccessory" Margin="0,0,0,8"/>
                <Border x:Name="VoiceIntro" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="DismissVoiceIntroButton" DockPanel.Dock="Right" Content="×" Width="30" Height="30"
                                Padding="0" Click="OnDismissVoiceIntro" ToolTip="Dismiss voice introduction"/>
                        <Button x:Name="StartVoiceIntroButton" DockPanel.Dock="Right" Content="Start Voice" Margin="12,0,10,0"
                                Padding="14,7" Click="OnStartVoiceIntro"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceIntroTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="VoiceIntroBody" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="SkillSuggestionBanner" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DismissSkillSuggestionButton" Margin="0,0,8,0"
                                    Padding="12,6" Click="OnDismissSkillSuggestion"/>
                            <Button x:Name="AcceptSkillSuggestionButton"
                                    Padding="12,6" Click="OnAcceptSkillSuggestion"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SkillSuggestionTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SkillSuggestionDescription" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="FollowUpSuggestionBanner" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DismissFollowUpSuggestionButton" Margin="0,0,8,0" Padding="12,6"
                                    Click="OnDismissFollowUpSuggestion"/>
                            <Button x:Name="AcceptFollowUpSuggestionButton" Padding="12,6"
                                    Click="OnAcceptFollowUpSuggestion"/>
                        </StackPanel>
                        <TextBlock x:Name="FollowUpSuggestionText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" MaxHeight="54"/>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="DropHint" Text="Drop files here" Visibility="Collapsed"
                           Margin="0,0,0,8" Foreground="{DynamicResource Accent}"/>
                <Border x:Name="ProjectMissingBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="LocateProjectButton" DockPanel.Dock="Right" Click="OnLocateProject"
                                Margin="8,0,0,0" Padding="10,4"/>
                        <TextBlock x:Name="ProjectMissingText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="DraftAttachments" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0"
                                                            ToolTipService.InitialShowDelay="350">
                                                        <Border.ToolTip>
                                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <StackPanel MaxWidth="420">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="Gray"/>
                                                                    <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="Gray"/>
                                                                    <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="48" Height="48" Stretch="UniformToFill"
                                           Source="{Binding FilePath, Converter={x:Static views:AttachmentImage.Instance}}"
                                           Visibility="{Binding IsImage, Converter={x:Static views:BoolToVis.Instance}}"/>
                                    <StackPanel Width="150" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Content="×" Tag="{Binding}" Click="OnRemoveAttachment"
                                            Padding="6,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ToggleButton x:Name="PlanButton" Content="💡 Plan" Padding="10,4"
                                  Click="OnPlanMode" ToolTip="Toggle plan mode"
                                  AutomationProperties.Name="Plan mode">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <Button x:Name="WorkLocationButton" Margin="8,0,0,0" Padding="10,4"
                            Click="OnWorkLocation" ToolTip="Choose where this task runs"/>
                </StackPanel>
                <Border x:Name="ProviderLimitWarning" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="◷" Margin="0,0,10,0" FontSize="16"
                                   Foreground="#F87171" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="ProviderLimitTitle" FontWeight="SemiBold" Foreground="#F87171"/>
                            <TextBlock x:Name="ProviderLimitCountdown" Margin="0,2,0,0" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="CacheResumeWarning" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CacheResumeInfoButton" DockPanel.Dock="Right" Content="ⓘ" Padding="6,2"
                                Margin="8,0,0,0" Click="OnCacheResumeInfo"/>
                        <TextBlock x:Name="CacheResumeText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                </Border>
                <Popup x:Name="CacheResumeInfoPopup" PlacementTarget="{Binding ElementName=CacheResumeInfoButton}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="320" Padding="12" CornerRadius="10" Background="{DynamicResource ChromeBackground}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                        <TextBlock x:Name="CacheResumeInfoText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                    </Border>
                </Popup>
                <DockPanel>
                    <Button x:Name="AddButton" DockPanel.Dock="Left" Content="+" FontSize="18" Width="36" Height="36"
                            Padding="0" Margin="0,0,8,0" Click="OnAddMenu"/>
                    <Button x:Name="VoiceButton" DockPanel.Dock="Right" Content="Mic" Width="80" Height="36"
                            Margin="8,0,0,0" Click="OnVoice" ToolTip="Start voice input"/>
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="80" Height="36"
                            Margin="8,0,0,0" Click="OnSend" IsDefault="True"/>
                    <TextBox x:Name="DraftBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="36" MaxHeight="140"
                             VerticalScrollBarVisibility="Auto"
                             Padding="10,8"
                             PreviewKeyDown="OnDraftKey"/>
                </DockPanel>
                <TextBlock x:Name="VoiceStatus"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <Border x:Name="GitBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="GitBarCloseButton" DockPanel.Dock="Right" Content="✕" Padding="8,2" Background="Transparent"
                        BorderThickness="0" Click="OnGitBarClose"/>
                <Button x:Name="CreatePrButton" DockPanel.Dock="Right" Padding="12,3" Margin="0,0,4,0" Click="OnCreatePr"/>
                <StackPanel x:Name="GitStat" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GitAdded" FontFamily="Consolas" Foreground="#4CC26A"/>
                    <TextBlock x:Name="GitRemoved" FontFamily="Consolas" Foreground="#F0506E" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="GitBarText" FontFamily="Consolas" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
            </DockPanel>
        </Border>
        <Border x:Name="QueueBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <StackPanel x:Name="QueueRows"/>
        </Border>
        <Border x:Name="PlanBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <StackPanel x:Name="PlanRows"/>
        </Border>
        <Border x:Name="QuestionBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="QuestionTitle" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="QuestionSkipButton" Margin="0,0,8,0" Click="OnQuestionSkip"/>
                    <Button x:Name="QuestionSubmitButton" Click="OnQuestionSubmit"/>
                </StackPanel>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuestionOptions"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border x:Name="VisionBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="VisionTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VisionReason" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VisionRejectButton" Content="Not now" Margin="0,0,8,0" Click="OnVisionReject"/>
                    <Button x:Name="VisionAllowButton" Content="Download and continue" Click="OnVisionAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ContextOverflowBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ContextOverflowTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ContextOverflowReason" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ContextOverflowSummary" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="ContextOverflowDeclineButton" Margin="0,0,8,0" Click="OnContextOverflowDecline"/>
                    <Button x:Name="ContextOverflowAcceptButton" Click="OnContextOverflowAccept"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ConflictBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="ConflictTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="ConflictBody" Margin="0,3,0,8" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="ConflictKeepWaitingButton" Margin="0,0,8,0" Click="OnConflictKeepWaiting"/>
                    <Button x:Name="ConflictStopHolderButton" Margin="0,0,8,0" Click="OnConflictStopHolder"/>
                    <Button x:Name="ConflictStopAllButton" Margin="0,0,8,0" Click="OnConflictStopAll"/>
                    <Button x:Name="ConflictSkipButton" Click="OnConflictSkip"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border x:Name="LeaseWaitingBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <Image x:Name="LeaseWaitingLoadingAnimation" DockPanel.Dock="Left" Width="24" Height="24"
                       Margin="0,0,10,0" Stretch="Uniform" IsHitTestVisible="False"/>
                <TextBlock x:Name="LeaseWaitingText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border x:Name="ApprovalBar" DockPanel.Dock="Bottom" Style="{StaticResource ComposerBannerStyle}" Visibility="Collapsed">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ApprovalTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ApprovalReason" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RejectButton" Content="Reject" Margin="0,0,8,0" Click="OnReject"/>
                    <Button x:Name="AllowButton" Content="Allow once" Click="OnAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="TerminalPanel" DockPanel.Dock="Bottom" Height="280" MinHeight="160"
                Background="#171717" Visibility="Collapsed">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="34" Background="#202020">
                    <Button x:Name="CloseTerminalButton" DockPanel.Dock="Right" Content="×"
                            Width="34" Padding="0" Click="OnCloseTerminal"/>
                    <TextBlock x:Name="TerminalTitle" Text="Terminal" Margin="14,0" VerticalAlignment="Center"
                               Foreground="#E6E6E6" FontSize="12"/>
                </DockPanel>
                <views:TerminalTextBox x:Name="TerminalBox"
                                       Background="#171717" Foreground="#E6E6E6" CaretBrush="#E6E6E6"
                                       BorderThickness="0" Padding="14,12"
                                       FontFamily="Consolas" FontSize="13"
                                       TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True"
                                       IsReadOnly="True"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyHint"
                           Margin="24"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Start a conversation from the sidebar."/>
                <TextBlock x:Name="WorkingIndicator"
                           Margin="24,0,24,8"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           AutomationProperties.LiveSetting="Polite"/>
                <ItemsControl x:Name="Messages" Margin="24,8,24,24" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,20" MaxWidth="760" HorizontalAlignment="{Binding Kind, Converter={x:Static views:KindAlignment.Instance}}">
                                <StackPanel>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="11"
                                            Background="{DynamicResource PanelBackground}"
                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                            Visibility="{Binding ., Converter={x:Static views:ContextCompactionVisibility.Instance}}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="↘" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ., Converter={x:Static views:ContextCompactionLabel.Instance}}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Text}" Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           Visibility="{Binding ., Converter={x:Static views:ActivityDetailVisibility.Instance}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
<Grid>
                                    <StackPanel Visibility="{Binding ., Converter={x:Static views:NotPlanVisibility.Instance}}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Kind, Converter={x:Static views:KindLabel.Instance}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       Visibility="{Binding Kind, Converter={x:Static views:MessageKindLabelVisibility.Instance}}"/>
                                            <TextBlock Text="…" HorizontalAlignment="Right"
                                                       Visibility="{Binding Streaming, Converter={x:Static views:BoolToVis.Instance}}"/>
                                        </DockPanel>
                                        <Border Margin="0,4,0,0" Padding="9,7" CornerRadius="10"
                                                Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                Visibility="{Binding ., Converter={x:Static views:ToolActivityVisibility.Instance}}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Text, Converter={x:Static views:ToolActivityIcon.Instance}}"
                                                           Width="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Text, Converter={x:Static views:ToolActivityStateIcon.Instance}}"
                                                           Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                             Visibility="{Binding Text, Converter={x:Static views:ToolActivityStateVisibility.Instance}}"/>
                                                <ProgressBar DockPanel.Dock="Right" Width="28" Height="4" Margin="8,0,0,0"
                                                             IsIndeterminate="True" VerticalAlignment="Center"
                                                             Visibility="{Binding Text, Converter={x:Static views:ToolActivityRunningVisibility.Instance}}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text, Converter={x:Static views:ToolActivityLabel.Instance}}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Text, Converter={x:Static views:ToolActivityDetail.Instance}}"
                                                               Margin="0,2,0,0" FontSize="10" FontFamily="Consolas"
