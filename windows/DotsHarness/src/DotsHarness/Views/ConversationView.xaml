                                            <TextBlock Text="…" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding IsTranslating, Converter={x:Static views:BoolToVis.Instance}}"/>
                                            <Button Tag="{Binding}" Click="OnFeedbackGood" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=feedback.good}" Visibility="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=feedback}">
                                                <Path Data="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z" Fill="{Binding Feedback, Converter={x:Static views:FeedbackBrush.Instance}, ConverterParameter=good}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnFeedbackBad" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=feedback.bad}" Visibility="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=feedback}">
                                                <Path Data="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z" Fill="{Binding Feedback, Converter={x:Static views:FeedbackBrush.Instance}, ConverterParameter=bad}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <TextBlock Text="{Binding CreatedAt, Converter={x:Static views:RelativeTime.Instance}}" FontSize="13"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="PendingMessages" Margin="24,0,24,24" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="12" CornerRadius="12"
                                    Visibility="{Binding Mode, Converter={x:Static views:PromptModeSteerOnly.Instance}}"
                                    Background="{DynamicResource BubbleUser}" Opacity="0.72">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steer}" Tag="{Binding}" Click="OnSteerPending"
                                                    Visibility="{Binding Mode, Converter={x:Static views:PromptModeSteerVisibility.Instance}}"
                                                    Padding="10,2" Margin="8,0,0,0"
                                                    ToolTip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steerHelp}"/>
                                            <TextBlock Text="{Binding Placement, Converter={x:Static views:PromptPlacementLabel.Instance}}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Mode, Converter={x:Static views:PromptModeLabel.Instance}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0"
                                                        ToolTipService.InitialShowDelay="350">
                                                    <Border.ToolTip>
                                                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                            <StackPanel MaxWidth="420">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="Gray"/>
                                                                <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="Gray"/>
                                                                <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="64" Height="64" Stretch="UniformToFill"
                                                               Source="{Binding FilePath, Converter={x:Static views:AttachmentImage.Instance}}"
                                                               Visibility="{Binding IsImage, Converter={x:Static views:BoolToVis.Instance}}"/>
                                                        <StackPanel Width="170" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="CompletedPlanSummary" Margin="24,0,24,12" Padding="9"
                        MaxWidth="760" HorizontalAlignment="Left" CornerRadius="9"
                        Background="{DynamicResource PanelBackground}" Visibility="Collapsed">
                    <StackPanel x:Name="CompletedPlanRows"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
        <!-- Cover the native detail-pane top separator at the chat boundary. -->
        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource PanelBackground}"
                IsHitTestVisible="False" Panel.ZIndex="10"/>
    </Grid>
</UserControl>
