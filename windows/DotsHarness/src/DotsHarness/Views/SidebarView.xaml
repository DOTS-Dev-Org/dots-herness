<UserControl x:Class="DotsHarness.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DotsHarness.Views"
             Background="{DynamicResource ChromeBackground}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
            <TextBlock x:Name="ChatsText" Text="Chats" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NewButton" Content="+" Width="28" Height="26" Click="OnNew" ToolTip="New chat" Margin="0,0,6,0"/>
            </StackPanel>
        </DockPanel>
        <UniformGrid x:Name="AreaPicker" DockPanel.Dock="Top" Rows="1" Columns="2" Margin="10,0,10,8">
            <Button x:Name="ChatAreaButton" Content="Sohbet" Click="OnChatArea" Padding="8,5" Margin="0,0,4,0"/>
            <Button x:Name="CodingAreaButton" Content="Kodlama" Click="OnCodingArea" Padding="8,5" Margin="4,0,0,0"/>
        </UniformGrid>
        <StackPanel x:Name="CodingProjectsPanel" DockPanel.Dock="Top" Margin="12,0,12,8">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="NewCodingProjectButton" Content="+" DockPanel.Dock="Right" Width="22" Height="20"
                        Padding="0" Click="OnNewCodingProject" ToolTip="Yeni kodlama projesi"/>
                <TextBlock x:Name="CodingProjectsText" Text="Kodlama projeleri" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="CodingProjectList" Height="86" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnCodingProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel x:Name="ChatProjectsPanel" DockPanel.Dock="Top" Margin="12,0,12,8">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="NewChatProjectButton" Content="+" DockPanel.Dock="Right" Width="22" Height="20"
                        Padding="0" Click="OnNewChatProject" ToolTip="Yeni sohbet projesi"/>
                <TextBlock x:Name="ChatProjectsText" Text="Sohbet projeleri" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>
            <Button x:Name="NoChatProjectButton" Content="Genel sohbetler" HorizontalContentAlignment="Left"
                    Padding="8,4" Click="OnNoChatProject" Margin="0,0,0,3"/>
            <ListBox x:Name="ChatProjectList" Height="86" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnChatProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10">
            <views:SlotHost x:Name="FooterHost" DockPanel.Dock="Top" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
        <Button x:Name="UserButton"
                DockPanel.Dock="Bottom"
                Margin="10,0,10,10"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="OnUserMenu"
                ToolTip="User menu">
            <Button.ContextMenu>
                <ContextMenu Placement="Top">
                    <MenuItem x:Name="SettingsMenu" Header="Settings" Click="OnSettings"/>
                </ContextMenu>
            </Button.ContextMenu>
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Accent}">
                    <TextBlock Text="DY" Foreground="White" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DOTS YAZILIM" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="UserMenuText" Text="User menu" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Button>
        <ListBox x:Name="ChatList"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionChanged="OnSelect"
                 Margin="4,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,6">
                        <Ellipse Width="7" Height="7" Fill="#2ECC71" DockPanel.Dock="Right"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding Running, Converter={x:Static views:BoolToVis.Instance}}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
