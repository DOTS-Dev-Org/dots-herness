<Window x:Class="DotsHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DotsHarness.Views"
        Icon="pack://application:,,,/Resources/DotsHarness.ico"
        Title="Dots Harness"
        MinWidth="640" MinHeight="520"
        Width="1180" Height="760"
        SizeChanged="OnWindowSizeChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="TasksButton" Content="Tasks" Padding="10,4" Margin="0,8,6,8"
                            Click="OnTasks" ToolTip="Scheduled tasks"/>
                    <Button x:Name="PaneButton" Content="Panels" Padding="10,4" Margin="0,8,0,8"
                            Click="OnPanePicker" ToolTip="Open a side panel"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="SidebarToggle" Content="☰" Width="30" Height="28" Padding="0"
                            Click="OnToggleSidebar" ToolTip="Show or hide sidebar"/>
                    <TextBlock x:Name="WindowTitle" Text="DOTS Harness" Margin="10,0,0,0"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid x:Name="DesktopGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="250" MaxWidth="340"/>
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="5"/>
                <ColumnDefinition x:Name="ContentColumn" Width="*" MinWidth="280"/>
                <ColumnDefinition x:Name="DockSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="RightDockColumn" Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <views:SidebarView x:Name="Sidebar" Grid.Column="0"/>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
            <Grid x:Name="DetailHost" Grid.Column="2" Background="{DynamicResource PanelBackground}">
                <views:ConversationView x:Name="Conversation"/>
                <views:SettingsView x:Name="Settings" Visibility="Collapsed"/>
            </Grid>
            <GridSplitter x:Name="DockSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Visibility="Collapsed"/>
            <views:RightDockView x:Name="RightDock" Grid.Column="4" Visibility="Collapsed"/>
            <Button x:Name="CompactScrim" Grid.Column="0" Grid.ColumnSpan="5"
                    Panel.ZIndex="10" Visibility="Collapsed" Focusable="False"
                    Background="#66000000" BorderThickness="0" Padding="0"
                    Click="OnDismissCompactSidebar"/>
            <views:SlotHost x:Name="OverlayHost" Grid.Column="0" Grid.ColumnSpan="5"
                            Panel.ZIndex="20" IsHitTestVisible="True"/>
        </Grid>
    </Grid>
</Window>
