<Window x:Class="DotsHarness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DotsHarness.Views"
        Icon="pack://application:,,,/Resources/DotsHarness.ico"
        Title="Dots Harness"
        MinWidth="960" MinHeight="640"
        Width="1180" Height="760"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <views:SidebarView x:Name="Sidebar" Grid.Column="0"/>
        <views:ConversationView x:Name="Conversation" Grid.Column="1"/>
        <views:SettingsView x:Name="Settings" Grid.Column="1" Visibility="Collapsed"/>
        <views:SlotHost x:Name="OverlayHost"
                        Grid.Column="0" Grid.ColumnSpan="2"
                        Panel.ZIndex="20"
                        IsHitTestVisible="True"/>
    </Grid>
</Window>
