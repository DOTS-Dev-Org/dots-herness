<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DotsHarnessCore</RootNamespace>
    <!-- ponytail: Linux-only build; Unix file-mode APIs are intentional -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Every shared source compiles here; VisionPlugin.cs belongs to its own project. -->
    <Compile Include="..\..\..\..\shared\*.cs" Exclude="..\..\..\..\shared\*Tests.cs;..\..\..\..\shared\VisionPlugin.cs" Link="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\..\shared\Localization.resx">
      <LogicalName>DotsHarnessCore.Localization.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\shared\cloud\herness-cloud.yml">
      <LogicalName>DotsHarnessCore.herness-cloud.yml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\..\..\shared\Localization.*.resx">
      <Link>%(Filename)%(Extension)</Link>
    </EmbeddedResource>
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\DshJson.cs" Link="DshJson.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\FileDownloader.cs" Link="FileDownloader.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\LocalModelCatalog.cs" Link="LocalModelCatalog.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\LocalRuntimeController.cs" Link="LocalRuntimeController.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\RouterCatalog.cs" Link="RouterCatalog.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\RouterController.cs" Link="RouterController.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\KeyboardShortcuts.cs" Link="KeyboardShortcuts.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\AgentBridge.cs" Link="AgentBridge.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\CronExpression.cs" Link="CronExpression.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\ScheduledTask.cs" Link="ScheduledTask.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\HarnessScheduler.cs" Link="HarnessScheduler.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\ScheduledTaskRunner.cs" Link="ScheduledTaskRunner.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\SchedulerService.cs" Link="SchedulerService.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\AppModel.cs" Link="AppModel.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\AppModel.Sandbox.cs" Link="AppModel.Sandbox.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\SessionProjector.cs" Link="SessionProjector.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\NativeClipboard.cs" Link="NativeClipboard.cs" />
    <Compile Include="..\..\..\..\windows\DotsHarness\src\DotsHarnessCore\NativePluginAuthor.cs" Link="NativePluginAuthor.cs" />
    <ProjectReference Include="..\HarnessPluginKit\HarnessPluginKit.csproj" />
    <ProjectReference Include="..\PluginRuntime\PluginRuntime.csproj" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>
</Project>
