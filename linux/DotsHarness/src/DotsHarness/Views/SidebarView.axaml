<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DotsHarness.Views"
             x:Class="DotsHarness.Views.SidebarView"
             Background="{DynamicResource ChromeBackground}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
            <TextBlock x:Name="ChatsText" Text="Chats" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimary}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="NewButton" Content="+" Width="28" Height="26" Click="OnNew" ToolTip.Tip="New chat" Margin="0,0,6,0"/>
                <Button x:Name="SettingsButton" Content="⚙" Width="28" Height="26" Click="OnSettings" ToolTip.Tip="Settings"/>
            </StackPanel>
        </DockPanel>
        <StackPanel x:Name="AreaPicker" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="10,0,10,8">
            <Button x:Name="ChatAreaButton" Content="Sohbet" Click="OnChatArea" Padding="8,5" HorizontalContentAlignment="Center" Width="96" Margin="0,0,4,0"/>
            <Button x:Name="CodingAreaButton" Content="Kodlama" Click="OnCodingArea" Padding="8,5" HorizontalContentAlignment="Center" Width="96" Margin="4,0,0,0"/>
        </StackPanel>
        <StackPanel x:Name="CodingProjectsPanel" DockPanel.Dock="Top" Margin="12,0,12,8">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="NewCodingProjectButton" Content="+" DockPanel.Dock="Right" Width="22" Height="20"
                        Padding="0" Click="OnNewCodingProject" ToolTip.Tip="Yeni kodlama projesi"/>
                <TextBlock x:Name="CodingProjectsText" Text="Kodlama projeleri" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>
            <ListBox x:Name="CodingProjectList" Height="86" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnCodingProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <StackPanel x:Name="ChatProjectsPanel" DockPanel.Dock="Top" Margin="12,0,12,8">
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="NewChatProjectButton" Content="+" DockPanel.Dock="Right" Width="22" Height="20"
                        Padding="0" Click="OnNewChatProject" ToolTip.Tip="Yeni sohbet projesi"/>
                <TextBlock x:Name="ChatProjectsText" Text="Sohbet projeleri" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </DockPanel>
            <Button x:Name="NoChatProjectButton" Content="Genel sohbetler" HorizontalContentAlignment="Left"
                    Padding="8,4" Click="OnNoChatProject" Margin="0,0,0,3"/>
            <ListBox x:Name="ChatProjectList" Height="86" BorderThickness="0" Background="Transparent"
                     SelectionChanged="OnChatProjectSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}" Margin="4,3"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10">
            <views:SlotHost x:Name="FooterHost" DockPanel.Dock="Top" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
        <ListBox x:Name="ChatList"
                 BorderThickness="0"
                 Background="Transparent"
                 SelectionChanged="OnSelect"
                 Margin="4,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,6">
                        <Ellipse Width="7" Height="7" Fill="#2ECC71" DockPanel.Dock="Right"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding Running}"/>
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimary}"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
