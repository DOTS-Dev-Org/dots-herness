<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:DotsHarnessCore"
             xmlns:views="using:DotsHarness.Views"
             x:Class="DotsHarness.Views.SidebarView"
             x:DataType="core:AppModel"
             Background="{DynamicResource ChromeBackground}">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="12,10,12,7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SearchButton" Content="⌕" Width="28" Height="26" Click="OnSearch"
                        ToolTip.Tip="Search" Margin="0,0,4,0"/>
                <Button x:Name="NotificationsButton" Content="🔔" Width="36" Height="26" Click="OnNotifications"
                        ToolTip.Tip="Notifications" Margin="0,0,4,0"/>
                <Button x:Name="SettingsButton" Content="⚙" Width="28" Height="26" Click="OnSettings"
                        ToolTip.Tip="Settings"/>
            </StackPanel>
            <TextBlock x:Name="ProjectsHeader" Text="Projects" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
        </DockPanel>

        <Border x:Name="SearchPanel" DockPanel.Dock="Top" Margin="10,0,10,7" Padding="8,0"
                Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="7" IsVisible="False">
            <DockPanel>
                <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Content="×" Width="24" Height="24"
                        Padding="0" Click="OnClearSearch" Background="Transparent" BorderThickness="0"/>
                <TextBox x:Name="SearchBox" BorderThickness="0" Padding="2,5" TextChanged="OnSearchChanged"
                         Watermark="Search projects and conversations"/>
            </DockPanel>
        </Border>

        <StackPanel x:Name="PrimaryNavigation" DockPanel.Dock="Top" Margin="10,0,10,8">
            <Button x:Name="NewChatButton" Content="□  New conversation" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnNew" Background="Transparent" BorderThickness="0"/>
            <Button x:Name="NoProjectButton" Content="◇  No project" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnNoProject" Background="Transparent" BorderThickness="0"/>
            <Button x:Name="PullRequestsButton" Content="⑂  Pull requests" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnPullRequests" Background="Transparent" BorderThickness="0"
                    ToolTip.Tip="Open pull requests for the active project"/>
            <Button x:Name="SitesButton" Content="▦  Sites" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnSites" Background="Transparent" BorderThickness="0"/>
            <Button x:Name="ScheduledButton" Content="◷  Scheduled tasks" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnScheduled" Background="Transparent" BorderThickness="0"/>
            <Button x:Name="PluginsButton" Content="◌  Plugins" HorizontalContentAlignment="Left"
                    Padding="8,5" Click="OnPlugins" Background="Transparent" BorderThickness="0"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="10">
            <views:SlotHost x:Name="FooterHost" DockPanel.Dock="Top" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{DynamicResource TextSecondary}"/>
        </DockPanel>
        <Button x:Name="UserButton" DockPanel.Dock="Bottom" Margin="10,0,10,10" Padding="10,8"
                HorizontalContentAlignment="Left" Click="OnUserMenu" ToolTip.Tip="User menu">
            <StackPanel Orientation="Horizontal">
                <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Accent}">
                    <TextBlock Text="DY" Foreground="White" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="DOTS YAZILIM" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="UserMenuText" Text="User menu" FontSize="10"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <DockPanel Margin="12,0,12,4">
                    <Button x:Name="ProjectsToggle" DockPanel.Dock="Left" Content="⌄  Projects"
                            Padding="0" Click="OnToggleProjects" Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource TextSecondary}"/>
                    <Button x:Name="ProjectsOptionsButton" DockPanel.Dock="Right" Content="⋯" Width="22" Height="20"
                            Padding="0" Click="OnProjectOptions" ToolTip.Tip="Organize projects"/>
                    <Button x:Name="NewProjectButton" DockPanel.Dock="Right" Content="+" Width="22" Height="20"
                            Padding="0" Click="OnNewProject" ToolTip.Tip="Add project"/>
                </DockPanel>
                <StackPanel x:Name="ProjectsPanel" Margin="12,0,12,8">
                    <ListBox x:Name="ProjectList" MaxHeight="240" BorderThickness="0" Background="Transparent"
                             SelectionChanged="OnProjectSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding DisplayTitle}" Opacity="{Binding Opacity}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}" Margin="4,3"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <DockPanel Margin="12,0,12,4">
                    <TextBlock x:Name="ConversationsHeader" Text="Conversations" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Button x:Name="NewButton" DockPanel.Dock="Right" Content="+" Width="22" Height="20"
                            Padding="0" Click="OnNew" ToolTip.Tip="New conversation"/>
                </DockPanel>
                <ListBox x:Name="ConversationList" Height="154" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnSelect" Margin="8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:Conversation">
                            <DockPanel Margin="4,5">
                                <Button DockPanel.Dock="Right" Content="☆" Width="22" Height="22" Padding="0"
                                        Tag="{Binding}" Loaded="OnPinConversationLoaded" Click="OnTogglePinnedConversation"
                                        AutomationProperties.Name="Pin conversation"/>
                                <Button DockPanel.Dock="Right" Content="⇩" Width="22" Height="22" Padding="0"
                                        Margin="4,0,0,0" Tag="{Binding}" Loaded="OnArchiveConversationLoaded"
                                        Click="OnArchiveConversation"/>
                                <Ellipse Width="7" Height="7" Fill="#2ECC71" DockPanel.Dock="Right"
                                         VerticalAlignment="Center" IsVisible="{Binding Running}"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button x:Name="RecentToggle" Content="⌄  Recent" HorizontalContentAlignment="Left"
                        Margin="12,8,12,4" Padding="0" Click="OnToggleRecent" Background="Transparent"
                        BorderThickness="0" Foreground="{DynamicResource TextSecondary}"/>
                <ListBox x:Name="RecentList" Height="154" BorderThickness="0" Background="Transparent"
                         SelectionChanged="OnRecentSelect" Margin="8,0,8,10">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="core:Conversation">
                            <DockPanel Margin="4,5">
                                <Button DockPanel.Dock="Right" Content="☆" Width="22" Height="22" Padding="0"
                                        Tag="{Binding}" Loaded="OnPinConversationLoaded" Click="OnTogglePinnedConversation"
                                        AutomationProperties.Name="Pin conversation"/>
                                <Button DockPanel.Dock="Right" Content="⇩" Width="22" Height="22" Padding="0"
                                        Margin="4,0,0,0" Tag="{Binding}" Loaded="OnArchiveConversationLoaded"
                                        Click="OnArchiveConversation"/>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}" DockPanel.Dock="Right"
                                         VerticalAlignment="Center" IsVisible="{Binding Running}"/>
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
