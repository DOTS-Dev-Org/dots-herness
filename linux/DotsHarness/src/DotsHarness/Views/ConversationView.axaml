<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="using:DotsHarnessCore"
             xmlns:views="using:DotsHarness.Views"
             x:Class="DotsHarness.Views.ConversationView"
             x:DataType="core:AppModel"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.DragLeave="OnDragLeave"
             DragDrop.Drop="OnDrop"
             Background="{DynamicResource PanelBackground}">
    <UserControl.Styles>
        <Style Selector="Border.composer-banner">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Styles>
    <Grid>
        <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="20,14,20,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CacheUsageButton" Content="Context" Margin="0,0,8,0" Padding="10,4" IsVisible="False">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="6">
                                <TextBlock x:Name="ContextUsageSummary" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="ContextUsageProgress" Minimum="0" Maximum="1" Height="5" IsVisible="False"/>
                                <TextBlock x:Name="ContextUsageBreakdown" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="CacheUsageDetails" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="TerminalButton" Content="Terminal" Padding="12,4"
                        Click="OnTerminal"/>
                <Button x:Name="ModelPicker" Margin="8,0,0,0" Padding="12,4" ToolTip.Tip="Model">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ModelPickerName" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ModelPickerEffort" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="⌄" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opened="OnModelFlyoutOpened">
                            <StackPanel Width="300" Spacing="8">
                                <Border x:Name="EffortCard" CornerRadius="12" Padding="10" Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="28,*,28">
                                            <Button x:Name="EffortTitleButton" Grid.Column="1" HorizontalAlignment="Center" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Click="OnShowModels">
                                                <StackPanel>
                                                    <TextBlock x:Name="EffortTitle" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="EffortModelName" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EffortResetButton" Grid.Column="2" Content="↺" Padding="4,0"
                                                    Background="Transparent" Click="OnEffortReset"/>
                                        </Grid>
                                        <Canvas x:Name="EffortTrack" Height="30" Background="Transparent"
                                                PointerPressed="OnEffortPressed" PointerMoved="OnEffortPointer"
                                                SizeChanged="OnEffortTrackSized"/>
                                        <Button x:Name="UsageModeButton" Margin="0,8,0,0" Padding="8,3"
                                                HorizontalAlignment="Center" Click="OnUsageMode"/>
                                        <Button x:Name="FastModeButton" Margin="0,6,0,0" Padding="8,3" IsVisible="False"
                                                HorizontalAlignment="Center" Click="OnFastMode"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ModelListPanel" IsVisible="False">
                                    <Button x:Name="ModelListBack" HorizontalAlignment="Left" Padding="10,4" Background="Transparent"
                                            BorderThickness="0" Click="OnHideModels">
                                        <TextBlock x:Name="ModelListHeader" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                    <ListBox x:Name="ModelList" MaxHeight="340" Background="Transparent"
                                             SelectionChanged="OnModelChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Image x:Name="ComposerLoadingAnimation" Width="20" Height="20" Margin="0,0,2,0"
                       IsVisible="False" Stretch="Uniform" IsHitTestVisible="False"/>
                <Button x:Name="StopButton" Content="Stop" Margin="8,0,0,0" Padding="12,4"
                        Click="OnStop" IsVisible="False"/>
                <Button x:Name="CancelPlanButton" Content="Cancel plan" Margin="8,0,0,0" Padding="12,4"
                        Click="OnCancelPlanFromComposer" IsVisible="False"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackground}" Padding="16">
            <DockPanel>
                <views:SlotHost x:Name="ComposerAccessory" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <Border x:Name="VoiceIntro" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <Button x:Name="DismissVoiceIntroButton" DockPanel.Dock="Right" Content="×" Width="30" Height="30"
                                Padding="0" Click="OnDismissVoiceIntro" ToolTip.Tip="Dismiss voice introduction"/>
                        <Button x:Name="StartVoiceIntroButton" DockPanel.Dock="Right" Content="Start Voice" Margin="12,0,10,0"
                                Padding="14,7" Click="OnStartVoiceIntro"/>
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Width="28" Height="28" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}"
                                      Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 Z M17.3,11 C17.3,14 14.76,16.1 12,16.1 C9.24,16.1 6.7,14 6.7,11 L5,11 C5,14.41 7.72,17.23 11,17.72 L11,21 L9,21 L9,23 L15,23 L15,21 L13,21 L13,17.72 C16.28,17.23 19,14.41 19,11 Z"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceIntroTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="VoiceIntroBody" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="SkillSuggestionBanner" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DismissSkillSuggestionButton" Margin="0,0,8,0"
                                    Padding="12,6" Click="OnDismissSkillSuggestion"/>
                            <Button x:Name="AcceptSkillSuggestionButton"
                                    Padding="12,6" Click="OnAcceptSkillSuggestion"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SkillSuggestionTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SkillSuggestionDescription" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="FollowUpSuggestionBanner" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DismissFollowUpSuggestionButton" Margin="0,0,8,0" Padding="12,6"
                                    Click="OnDismissFollowUpSuggestion"/>
                            <Button x:Name="AcceptFollowUpSuggestionButton" Padding="12,6"
                                    Click="OnAcceptFollowUpSuggestion"/>
                        </StackPanel>
                        <TextBlock x:Name="FollowUpSuggestionText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}" MaxHeight="54"/>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="DropHint" DockPanel.Dock="Top" Text="Drop files here"
                           IsVisible="False" Margin="0,0,0,8"
                           Foreground="{DynamicResource Accent}"/>
                <Border x:Name="ProjectMissingBanner" DockPanel.Dock="Top" IsVisible="False"
                        Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="LocateProjectButton" DockPanel.Dock="Right" Click="OnLocateProject"
                                Margin="8,0,0,0" Padding="10,4"/>
                        <TextBlock x:Name="ProjectMissingText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                </Border>
                <ItemsControl x:Name="DraftAttachments" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ChatAttachment">
                                                <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                    <ToolTip.Tip>
                                                        <Border Padding="10" MaxWidth="420" Background="{DynamicResource PanelBackground}"
                                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                            <StackPanel Spacing="3">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </ToolTip.Tip>
                                <StackPanel Orientation="Horizontal">
                                    <views:AsyncAttachmentImage Width="48" Height="48" Stretch="UniformToFill"
                                                                  FilePath="{Binding FilePath}"
                                                                  IsVisible="{Binding IsImage}"/>
                                    <StackPanel Width="150" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Content="×" Tag="{Binding}" Click="OnRemoveAttachment"
                                            Padding="6,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ToggleButton x:Name="PlanButton" Content="💡 Plan" Padding="10,4"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Click="OnPlanMode" ToolTip.Tip="Toggle plan mode"
                                  AutomationProperties.Name="Plan mode">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Style>
                        </ToggleButton.Styles>
                    </ToggleButton>
                    <Button x:Name="WorkLocationButton" Margin="8,0,0,0" Padding="10,4"
                            Click="OnWorkLocation" ToolTip.Tip="Choose where this task runs"/>
                </StackPanel>
                <Border x:Name="ProviderLimitWarning" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="◷" Margin="0,0,10,0" FontSize="16"
                                   Foreground="#F87171" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="ProviderLimitTitle" FontWeight="SemiBold" Foreground="#F87171"/>
                            <TextBlock x:Name="ProviderLimitCountdown" Margin="0,2,0,0" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="CacheResumeWarning" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <Button x:Name="CacheResumeInfoButton" DockPanel.Dock="Right" Content="ⓘ" Padding="6,2"
                                Margin="8,0,0,0" ToolTip.Tip="Cache information">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <Border Width="320" Padding="12" CornerRadius="10" Background="{DynamicResource ChromeBackground}"
                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                        <TextBlock x:Name="CacheResumeInfoText" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock x:Name="CacheResumeText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </DockPanel>
                </Border>
                <Button x:Name="AddButton" DockPanel.Dock="Left" Content="+" FontSize="18" Width="36" Height="36"
                        Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Center" Click="OnAddMenu"/>
                <Button x:Name="VoiceButton" DockPanel.Dock="Right" Content="Mic" Width="80" Height="36"
                        Margin="8,0,0,0" Click="OnVoice" ToolTip.Tip="Start voice input"/>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="80" Height="36"
                        Margin="8,0,0,0" Click="OnSend"/>
                <TextBox x:Name="DraftBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="36" MaxHeight="140"
                         Padding="10,8"
                         KeyDown="OnDraftKey"/>
                <TextBlock x:Name="VoiceStatus" DockPanel.Dock="Top" Margin="0,6,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" IsVisible="False"/>
            </DockPanel>
        </Border>
        <Border x:Name="GitBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <Button x:Name="GitBarCloseButton" DockPanel.Dock="Right" Content="✕" Padding="8,2" Background="Transparent"
                        BorderThickness="0" Click="OnGitBarClose"/>
                <Button x:Name="CreatePrButton" DockPanel.Dock="Right" Padding="12,3" Margin="0,0,4,0" Click="OnCreatePr"/>
                <StackPanel x:Name="GitStat" DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="GitAdded" FontFamily="monospace" Foreground="#4CC26A"/>
                    <TextBlock x:Name="GitRemoved" FontFamily="monospace" Foreground="#F0506E" Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="GitBarText" FontFamily="monospace" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondary}"/>
            </DockPanel>
        </Border>
        <Border x:Name="QueueBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <StackPanel x:Name="QueueRows"/>
        </Border>
        <Border x:Name="PlanBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <StackPanel x:Name="PlanRows"/>
        </Border>
        <Border x:Name="QuestionBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <TextBlock x:Name="QuestionTitle" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="QuestionSkipButton" Margin="0,0,8,0" Click="OnQuestionSkip"/>
                    <Button x:Name="QuestionSubmitButton" Click="OnQuestionSubmit"/>
                </StackPanel>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuestionOptions"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border x:Name="VisionBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="VisionTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VisionReason" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VisionRejectButton" Content="Not now" Margin="0,0,8,0" Click="OnVisionReject"/>
                    <Button x:Name="VisionAllowButton" Content="Download and continue" Click="OnVisionAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ContextOverflowBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ContextOverflowTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ContextOverflowReason" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ContextOverflowSummary" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="ContextOverflowDeclineButton" Margin="0,0,8,0" Click="OnContextOverflowDecline"/>
                    <Button x:Name="ContextOverflowAcceptButton" Click="OnContextOverflowAccept"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ConflictBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <StackPanel Spacing="5">
                <TextBlock x:Name="ConflictTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="ConflictBody" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button x:Name="ConflictKeepWaitingButton" Margin="0,0,8,0" Click="OnConflictKeepWaiting"/>
                    <Button x:Name="ConflictStopHolderButton" Margin="0,0,8,0" Click="OnConflictStopHolder"/>
                    <Button x:Name="ConflictStopAllButton" Margin="0,0,8,0" Click="OnConflictStopAll"/>
                    <Button x:Name="ConflictSkipButton" Click="OnConflictSkip"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Border x:Name="LeaseWaitingBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <Image x:Name="LeaseWaitingLoadingAnimation" DockPanel.Dock="Left" Width="24" Height="24"
                       Margin="0,0,10,0" Stretch="Uniform" IsHitTestVisible="False"/>
                <TextBlock x:Name="LeaseWaitingText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <Border x:Name="ApprovalBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ApprovalTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ApprovalReason" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RejectButton" Content="Reject" Margin="0,0,8,0" Click="OnReject"/>
                    <Button x:Name="AllowButton" Content="Allow once" Click="OnAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="TerminalPanel" DockPanel.Dock="Bottom" Height="280" MinHeight="160"
                Background="#171717" IsVisible="False">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="34" Background="#202020">
                    <Button x:Name="CloseTerminalButton" DockPanel.Dock="Right" Content="×"
                            Width="34" Padding="0" Click="OnCloseTerminal"/>
                    <TextBlock x:Name="TerminalTitle" Text="Terminal" Margin="14,0" VerticalAlignment="Center"
                               Foreground="#E6E6E6" FontSize="12"/>
                </DockPanel>
                <views:TerminalTextBox x:Name="TerminalBox"
                                        Background="#171717" Foreground="#E6E6E6"
                                        CaretBrush="#E6E6E6" BorderThickness="0"
                                        Padding="14,12" FontFamily="monospace" FontSize="13"
                                        TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True"
                                        IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyHint"
                           Margin="24"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Start a conversation from the sidebar."/>
                <TextBlock x:Name="WorkingIndicator"
                           Margin="24,0,24,8"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
                <ItemsControl x:Name="Messages" Margin="24,8,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ChatMessage">
                            <Border Margin="0,0,0,10" MaxWidth="760" HorizontalAlignment="{Binding Kind, Converter={x:Static views:KindAlignment.Instance}}">
                                <StackPanel>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="11"
                                            Background="{DynamicResource PanelBackground}"
                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                            IsVisible="{Binding ., Converter={x:Static views:ContextCompactionVisibility.Instance}}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Left" Text="↘" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ., Converter={x:Static views:ContextCompactionLabel.Instance}}"
                                                           FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding Text}" Margin="0,2,0,0" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}"
                                                           IsVisible="{Binding ., Converter={x:Static views:ActivityDetailVisibility.Instance}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
<Grid>
                                    <StackPanel IsVisible="{Binding ., Converter={x:Static views:NotPlanVisibility.Instance}}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Kind, Converter={x:Static views:KindLabel.Instance}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       IsVisible="{Binding Kind, Converter={x:Static views:MessageKindLabelVisibility.Instance}}"/>
                                            <TextBlock Text="…" HorizontalAlignment="Right"
                                                       IsVisible="{Binding Streaming}"/>
                                        </DockPanel>
                                        <Border Margin="0,2,0,0" Padding="9,7" CornerRadius="10"
                                                Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                IsVisible="{Binding ., Converter={x:Static views:ToolActivityVisibility.Instance}}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Text, Converter={x:Static views:ToolActivityIcon.Instance}}"
                                                           Width="22" Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Text, Converter={x:Static views:ToolActivityStateIcon.Instance}}"
                                                           Margin="8,0,0,0" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"
                                                           IsVisible="{Binding Text, Converter={x:Static views:ToolActivityStateVisibility.Instance}}"/>
                                                <ProgressBar DockPanel.Dock="Right" Width="28" Height="4" Margin="8,0,0,0"
                                                             IsIndeterminate="True" VerticalAlignment="Center"
                                                             IsVisible="{Binding Text, Converter={x:Static views:ToolActivityRunningVisibility.Instance}}"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Text, Converter={x:Static views:ToolActivityLabel.Instance}}"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Text, Converter={x:Static views:ToolActivityDetail.Instance}}"
                                                               Margin="0,2,0,0" FontSize="10" FontFamily="Consolas"
                                                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="32"
                                                               IsVisible="{Binding Text, Converter={x:Static views:ToolActivityDetailVisibility.Instance}}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <views:MarkdownBody Text="{Binding Text}" Margin="0,3,0,0" TextAlignment="{Binding Kind, Converter={x:Static views:KindTextAlignment.Instance}}"
                                                            TextElement.Foreground="{DynamicResource TextPrimary}"
                                                            IsVisible="{Binding ., Converter={x:Static views:MessageBodyVisibility.Instance}}"/>
                                        <Expander IsExpanded="False" Margin="0,6,0,0"
                                                  Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.fullToolOutput}"
                                                  IsVisible="{Binding ., Converter={x:Static views:ToolOutputVisibility.Instance}}">
                                            <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding RawToolOutput}" TextWrapping="NoWrap" FontFamily="Consolas"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </ScrollViewer>
                                        </Expander>
                                        <TextBlock Text="{Binding ., Converter={x:Static views:RunSummaryLabel.Instance}}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding ., Converter={x:Static views:RunSummaryVisibility.Instance}}"/>
                                        <views:AsyncAttachmentImage MaxWidth="520" MaxHeight="520" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                                      FilePath="{Binding Media.FilePath}"/>
                                        <Button Content="▶" Width="32" Height="32" Padding="0" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Tag="{Binding Media}" Click="OnPlayMedia" ToolTip.Tip="Play"
                                                IsVisible="{Binding Media.IsAudio}"/>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:ChatAttachment">
                                                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                        <ToolTip.Tip>
                                                            <Border Padding="10" MaxWidth="420" Background="{DynamicResource PanelBackground}"
                                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                                <StackPanel Spacing="3">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                    <TextBlock Text="{Binding MimeType}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                                    <TextBlock Text="{Binding FilePath}" FontSize="11" TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </ToolTip.Tip>
                                                        <StackPanel Orientation="Horizontal">
                                                            <views:AsyncAttachmentImage Width="64" Height="64" Stretch="UniformToFill"
                                                                                       FilePath="{Binding FilePath}"
                                                                                       IsVisible="{Binding IsImage}"/>
                                                            <StackPanel Width="170" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Button Tag="{Binding}" Click="OnOpenAttachment" Padding="0" Background="Transparent" BorderThickness="0"
                                                                        HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                                </Button>
                                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander IsExpanded="False" Margin="0,8,0,0"
                                                  Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.used}"
                                                  IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=used}">
                                                <StackPanel Margin="8,6,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.skills}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <ItemsControl ItemsSource="{Binding UsedSkills}">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False">
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.tools}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <ItemsControl ItemsSource="{Binding UsedTools}">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False">
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                        <Border Margin="0,8,0,0" Padding="10" CornerRadius="10"
                                                Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=files}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFilesSummary.Instance}}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFilesLineSummary.Instance}}"
                                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.undoChanges}"
                                                                Tag="{Binding}" Click="OnUndoChanges" Margin="4,0"
                                                                IsVisible="{Binding Summary.UndoAvailable}"/>
                                                        <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.viewChanges}"
                                                                Tag="{Binding}" Click="OnToggleChangedFiles" Margin="4,0"
                                                                IsVisible="{Binding ChangedFilesRemaining.Count, Converter={x:Static views:PositiveCountVisibility.Instance}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding ChangedFilesPreview}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChangedFile">
                                                        <DockPanel LastChildFill="True" Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                       Foreground="{DynamicResource Accent}" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"
                                                                       ToolTip.ShowDelay="350">
                                                                <ToolTip.Tip>
                                                                    <Border Padding="10" MaxWidth="660" Background="{DynamicResource PanelBackground}"
                                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                                        <StackPanel Spacing="5">
                                                                            <DockPanel>
                                                                                <TextBlock Text="{Binding Path}" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                                           Margin="10,0,0,0" Foreground="{DynamicResource Accent}"/>
                                                                            </DockPanel>
                                                                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding Preview}" FontFamily="monospace" TextWrapping="NoWrap"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding ChangedFilesRemaining}"
                                                              IsVisible="{Binding IsChangedFilesExpanded}">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChangedFile">
                                                        <DockPanel LastChildFill="True" Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                       Foreground="{DynamicResource Accent}" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"
                                                                       ToolTip.ShowDelay="350">
                                                                <ToolTip.Tip>
                                                                    <Border Padding="10" MaxWidth="660" Background="{DynamicResource PanelBackground}"
                                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                                        <StackPanel Spacing="5">
                                                                            <DockPanel>
                                                                                <TextBlock Text="{Binding Path}" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                                           Margin="10,0,0,0" Foreground="{DynamicResource Accent}"/>
                                                                            </DockPanel>
                                                                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding Preview}" FontFamily="monospace" TextWrapping="NoWrap"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding ., Converter={x:Static views:ChangedFilesExpansionLabel.Instance}}"
                                                        Tag="{Binding}" Click="OnToggleChangedFiles" HorizontalAlignment="Left"
                                                        Margin="0,5,0,0" Padding="4,2"
                                                        IsVisible="{Binding ., Converter={x:Static views:ChangedFilesExpansionVisibility.Instance}}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border IsVisible="{Binding Kind, Converter={x:Static views:PlanVisibility.Instance}}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10"
                                            Padding="12" Background="{DynamicResource PanelBackground}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💡" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                               Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.plan}"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ., Converter={x:Static views:PlanStatus.Instance}}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,10"
                                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding ., Converter={x:Static views:RunSummaryLabel.Instance}}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       IsVisible="{Binding ., Converter={x:Static views:RunSummaryVisibility.Instance}}"/>
                                            <Expander Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.used}" IsExpanded="False" Margin="0,0,0,6"
                                                      IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=used}">
                                                <StackPanel Margin="8,6,0,0">
                                                    <TextBlock Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.skills}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding UsedSkills}">
                                                        <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False">
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.tools}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding UsedTools}">
                                                        <ItemsControl.ItemTemplate><DataTemplate x:CompileBindings="False">
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        <Border Margin="0,4,0,8" Padding="10" CornerRadius="10"
                                                Background="{DynamicResource PanelBackground}"
                                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                                IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=files}">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFilesSummary.Instance}}"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFilesLineSummary.Instance}}"
                                                                   Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                        <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.undoChanges}"
                                                                Tag="{Binding}" Click="OnUndoChanges" Margin="4,0"
                                                                IsVisible="{Binding Summary.UndoAvailable}"/>
                                                        <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.viewChanges}"
                                                                Tag="{Binding}" Click="OnToggleChangedFiles" Margin="4,0"
                                                                IsVisible="{Binding ChangedFilesRemaining.Count, Converter={x:Static views:PositiveCountVisibility.Instance}}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <ItemsControl ItemsSource="{Binding ChangedFilesPreview}" Margin="0,8,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChangedFile">
                                                        <DockPanel LastChildFill="True" Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                       Foreground="{DynamicResource Accent}" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"
                                                                       ToolTip.ShowDelay="350">
                                                                <ToolTip.Tip>
                                                                    <Border Padding="10" MaxWidth="660" Background="{DynamicResource PanelBackground}"
                                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                                        <StackPanel Spacing="5">
                                                                            <DockPanel>
                                                                                <TextBlock Text="{Binding Path}" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                                           Margin="10,0,0,0" Foreground="{DynamicResource Accent}"/>
                                                                            </DockPanel>
                                                                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding Preview}" FontFamily="monospace" TextWrapping="NoWrap"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding ChangedFilesRemaining}"
                                                              IsVisible="{Binding IsChangedFilesExpanded}">
                                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="core:ChangedFile">
                                                        <DockPanel LastChildFill="True" Margin="0,2">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                       Foreground="{DynamicResource Accent}" Margin="10,0,0,0"/>
                                                            <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"
                                                                       AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"
                                                                       ToolTip.ShowDelay="350">
                                                                <ToolTip.Tip>
                                                                    <Border Padding="10" MaxWidth="660" Background="{DynamicResource PanelBackground}"
                                                                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                                                        <StackPanel Spacing="5">
                                                                            <DockPanel>
                                                                                <TextBlock Text="{Binding Path}" FontFamily="monospace" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ., Converter={x:Static views:ChangedFileLineLabel.Instance}}"
                                                                                           Margin="10,0,0,0" Foreground="{DynamicResource Accent}"/>
                                                                            </DockPanel>
                                                                            <ScrollViewer MaxHeight="420" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                                                <TextBlock Text="{Binding Preview}" FontFamily="monospace" TextWrapping="NoWrap"/>
                                                                            </ScrollViewer>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding ., Converter={x:Static views:ChangedFilesExpansionLabel.Instance}}"
                                                        Tag="{Binding}" Click="OnToggleChangedFiles" HorizontalAlignment="Left"
                                                        Margin="0,5,0,0" Padding="4,2"
                                                        IsVisible="{Binding ., Converter={x:Static views:ChangedFilesExpansionVisibility.Instance}}"/>
                                            </StackPanel>
                                        </Border>
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.applyPlan}" Tag="{Binding}" Click="OnApplyPlan"
                                                    IsVisible="{Binding IsPendingPlan}"
                                                    IsEnabled="{Binding CanApplyPlan}" HorizontalAlignment="Left"
                                                    Padding="12,5" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.applyPlanHelp}"
                                                    AutomationProperties.Name="Apply plan"/>
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.cancelPlan}" Tag="{Binding}" Click="OnCancelPlan"
                                                    IsVisible="{Binding IsPendingPlan}"
                                                    IsEnabled="{Binding IsPendingPlan}" HorizontalAlignment="Left"
                                                    Padding="12,5" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.cancelPlanHelp}"
                                                    AutomationProperties.Name="Cancel plan"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                    <TextBlock Text="{Binding Translation}" TextWrapping="Wrap" Margin="0,8,0,0" TextAlignment="{Binding Kind, Converter={x:Static views:KindTextAlignment.Instance}}"
                                               Foreground="{DynamicResource TextPrimary}" IsVisible="{Binding HasTranslation}"/>
                                    <StackPanel Margin="0,8,0,0" HorizontalAlignment="{Binding Kind, Converter={x:Static views:KindAlignment.Instance}}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=row}">
                                        <StackPanel Orientation="Horizontal" Opacity="0.75" IsVisible="{Binding !Streaming}">
                                            <Button Tag="{Binding}" Click="OnCopyMessage" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.copy}" >
                                                <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnEditMessage" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.edit}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=user}">
                                                <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnRewindMessage" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.rewind}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=user}">
                                                <Path Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnSpeakMessage" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.speakResponse}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=assistant}">
                                                <Grid><Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" IsVisible="{Binding IsNotSpeaking}"/><Path Data="M6 6h12v12H6z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" IsVisible="{Binding IsSpeaking}"/></Grid>
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnTranslateMessage" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.translate}" >
                                                <Path Data="M12.87 15.07l-2.54-2.51.03-.03c1.74-1.94 2.98-4.17 3.71-6.53H17V4h-7V2H8v2H1v1.99h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <TextBlock Text="…" Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="{Binding IsTranslating}"/>
                                            <Button Tag="{Binding}" Click="OnFeedbackGood" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=feedback.good}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=feedback}">
                                                <Path Data="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z" Fill="{Binding Feedback, Converter={x:Static views:FeedbackBrush.Instance}, ConverterParameter=good}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <Button Tag="{Binding}" Click="OnFeedbackBad" Padding="4" Margin="0,0,10,0" Background="Transparent" BorderThickness="0" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=feedback.bad}" IsVisible="{Binding Kind, Converter={x:Static views:KindVisibility.Instance}, ConverterParameter=feedback}">
                                                <Path Data="M15 3H6c-.83 0-1.54.5-1.84 1.22l-3.02 7.05c-.09.23-.14.47-.14.73v2c0 1.1.9 2 2 2h6.31l-.95 4.57-.03.32c0 .41.17.79.44 1.06L9.83 23l6.59-6.59c.36-.36.58-.86.58-1.41V5c0-1.1-.9-2-2-2zm4 0v12h4V3h-4z" Fill="{Binding Feedback, Converter={x:Static views:FeedbackBrush.Instance}, ConverterParameter=bad}" Stretch="Uniform" Width="15" Height="15" />
                                            </Button>
                                            <TextBlock Text="{Binding CreatedAt, Converter={x:Static views:RelativeTime.Instance}}" FontSize="13"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel x:Name="FollowUpReplyButtons" Margin="24,-12,24,12" IsVisible="False"/>
                <ItemsControl x:Name="PendingMessages" Margin="24,0,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:PendingPrompt">
                            <Border Margin="0,0,0,12" Padding="12" CornerRadius="12"
                                    IsVisible="{Binding Mode, Converter={x:Static views:PromptModeSteerOnly.Instance}}"
                                    Background="{DynamicResource BubbleUser}" Opacity="0.72">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steer}" Tag="{Binding}" Click="OnSteerPending"
                                                    IsVisible="{Binding Mode, Converter={x:Static views:PromptModeSteerVisibility.Instance}}"
                                                    Padding="10,2" Margin="8,0,0,0"
                                                    ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steerHelp}"/>
                                            <TextBlock Text="{Binding Placement, Converter={x:Static views:PromptPlacementLabel.Instance}}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Mode, Converter={x:Static views:PromptModeLabel.Instance}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="core:ChatAttachment">
                                                <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <views:AsyncAttachmentImage Width="64" Height="64" Stretch="UniformToFill"
                                                                                     FilePath="{Binding FilePath}"
                                                                                     IsVisible="{Binding IsImage}"/>
                                                        <Button Content="▶" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                                                                Tag="{Binding}" Click="OnPlayAudio" ToolTip.Tip="Play"
                                                                IsVisible="{Binding IsAudio}"/>
                                                        <StackPanel Width="170" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="CompletedPlanSummary" Margin="24,0,24,12" Padding="9"
                        MaxWidth="760" HorizontalAlignment="Left" CornerRadius="9"
                        Background="{DynamicResource PanelBackground}" IsVisible="False">
                    <StackPanel x:Name="CompletedPlanRows"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
        <!-- Cover the native detail-pane top separator at the chat boundary. -->
        <Border Height="2" VerticalAlignment="Top" Background="{DynamicResource PanelBackground}"
                IsHitTestVisible="False" ZIndex="10"/>
    </Grid>
</UserControl>
