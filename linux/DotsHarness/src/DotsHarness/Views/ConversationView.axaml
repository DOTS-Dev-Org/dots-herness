<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DotsHarness.Views"
             x:Class="DotsHarness.Views.ConversationView"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnDragOver"
             DragDrop.DragLeave="OnDragLeave"
             DragDrop.Drop="OnDrop"
             Background="{DynamicResource PanelBackground}">
    <UserControl.Styles>
        <Style Selector="Border.composer-banner">
            <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="20,14,20,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="TerminalButton" Content="Terminal" Padding="12,4"
                        Click="OnTerminal"/>
                <Button x:Name="ModelPicker" Margin="8,0,0,0" Padding="12,4" ToolTip.Tip="Model">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="ModelPickerName" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock x:Name="ModelPickerEffort" Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock Text="⌄" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opened="OnModelFlyoutOpened">
                            <StackPanel Width="300" Spacing="8">
                                <Border x:Name="EffortCard" CornerRadius="12" Padding="10" Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="28,*,28">
                                            <Button x:Name="EffortTitleButton" Grid.Column="1" HorizontalAlignment="Center" Padding="0"
                                                    Background="Transparent" BorderThickness="0" Click="OnShowModels">
                                                <StackPanel>
                                                    <TextBlock x:Name="EffortTitle" FontSize="15" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock x:Name="EffortModelName" FontSize="11" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="EffortResetButton" Grid.Column="2" Content="↺" Padding="4,0"
                                                    Background="Transparent" Click="OnEffortReset"/>
                                        </Grid>
                                        <Canvas x:Name="EffortTrack" Height="30" Background="Transparent"
                                                PointerPressed="OnEffortPressed" PointerMoved="OnEffortPointer"
                                                SizeChanged="OnEffortTrackSized"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="ModelListPanel" IsVisible="False">
                                    <Button x:Name="ModelListBack" HorizontalAlignment="Left" Padding="10,4" Background="Transparent"
                                            BorderThickness="0" Click="OnHideModels">
                                        <TextBlock x:Name="ModelListHeader" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                    <ListBox x:Name="ModelList" MaxHeight="340" Background="Transparent"
                                             SelectionChanged="OnModelChanged"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="StopButton" Content="Stop" Margin="8,0,0,0" Padding="12,4"
                        Click="OnStop" IsVisible="False"/>
            </StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBackground}" Padding="16">
            <DockPanel>
                <views:SlotHost x:Name="ComposerAccessory" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <Border x:Name="VoiceIntro" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <Button x:Name="DismissVoiceIntroButton" DockPanel.Dock="Right" Content="×" Width="30" Height="30"
                                Padding="0" Click="OnDismissVoiceIntro" ToolTip.Tip="Dismiss voice introduction"/>
                        <Button x:Name="StartVoiceIntroButton" DockPanel.Dock="Right" Content="Start Voice" Margin="12,0,10,0"
                                Padding="14,7" Click="OnStartVoiceIntro"/>
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Width="28" Height="28" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimary}"
                                      Data="M12,14 C13.66,14 15,12.66 15,11 L15,5 C15,3.34 13.66,2 12,2 C10.34,2 9,3.34 9,5 L9,11 C9,12.66 10.34,14 12,14 Z M17.3,11 C17.3,14 14.76,16.1 12,16.1 C9.24,16.1 6.7,14 6.7,11 L5,11 C5,14.41 7.72,17.23 11,17.72 L11,21 L9,21 L9,23 L15,23 L15,21 L13,21 L13,17.72 C16.28,17.23 19,14.41 19,11 Z"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VoiceIntroTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="VoiceIntroBody" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border x:Name="SkillSuggestionBanner" DockPanel.Dock="Top" Classes="composer-banner" IsVisible="False">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DismissSkillSuggestionButton" Content="Not now" Margin="0,0,8,0"
                                    Padding="12,6" Click="OnDismissSkillSuggestion"/>
                            <Button x:Name="AcceptSkillSuggestionButton" Content="Create Skill"
                                    Padding="12,6" Click="OnAcceptSkillSuggestion"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SkillSuggestionTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SkillSuggestionDescription" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="DropHint" DockPanel.Dock="Top" Text="Drop files here"
                           IsVisible="False" Margin="0,0,0,8"
                           Foreground="{DynamicResource Accent}"/>
                <ItemsControl x:Name="DraftAttachments" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="48" Height="48" Stretch="UniformToFill"
                                           Source="{Binding FilePath, Converter={x:Static views:AttachmentImage.Instance}}"
                                           IsVisible="{Binding IsImage}"/>
                                    <StackPanel Width="150" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Content="×" Tag="{Binding}" Click="OnRemoveAttachment"
                                            Padding="6,0" VerticalAlignment="Top"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <ToggleButton x:Name="PlanButton" Content="💡 Plan" Padding="10,4"
                                  Foreground="{DynamicResource TextSecondary}"
                                  Click="OnPlanMode" ToolTip.Tip="Toggle plan mode"
                                  AutomationProperties.Name="Plan mode">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                            </Style>
                        </ToggleButton.Styles>
                    </ToggleButton>
                </StackPanel>
                <Button x:Name="VoiceButton" DockPanel.Dock="Right" Content="Mic" Width="80" Height="36"
                        Margin="8,0,0,0" Click="OnVoice" ToolTip.Tip="Start voice input"/>
                <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Width="80" Height="36"
                        Margin="8,0,0,0" Click="OnSend"/>
                <TextBox x:Name="DraftBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="36" MaxHeight="140"
                         Padding="10,8"
                         KeyDown="OnDraftKey"/>
                <TextBlock x:Name="VoiceStatus" DockPanel.Dock="Top" Margin="0,6,0,0" FontSize="11"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" IsVisible="False"/>
            </DockPanel>
        </Border>
        <Border x:Name="QuestionBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <TextBlock x:Name="QuestionTitle" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="QuestionSkipButton" Margin="0,0,8,0" Click="OnQuestionSkip"/>
                    <Button x:Name="QuestionSubmitButton" Click="OnQuestionSubmit"/>
                </StackPanel>
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="QuestionOptions"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Border x:Name="VisionBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="VisionTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="VisionReason" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="VisionRejectButton" Content="Not now" Margin="0,0,8,0" Click="OnVisionReject"/>
                    <Button x:Name="VisionAllowButton" Content="Download and continue" Click="OnVisionAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="ApprovalBar" DockPanel.Dock="Bottom" Classes="composer-banner" IsVisible="False">
            <DockPanel>
                <StackPanel>
                    <TextBlock x:Name="ApprovalTitle" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="ApprovalReason" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RejectButton" Content="Reject" Margin="0,0,8,0" Click="OnReject"/>
                    <Button x:Name="AllowButton" Content="Allow once" Click="OnAllow"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border x:Name="TerminalPanel" DockPanel.Dock="Bottom" Height="280" MinHeight="160"
                Background="#171717" IsVisible="False">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Height="34" Background="#202020">
                    <Button x:Name="CloseTerminalButton" DockPanel.Dock="Right" Content="×"
                            Width="34" Padding="0" Click="OnCloseTerminal"/>
                    <TextBlock x:Name="TerminalTitle" Text="Terminal" Margin="14,0" VerticalAlignment="Center"
                               Foreground="#E6E6E6" FontSize="12"/>
                </DockPanel>
                <views:TerminalTextBox x:Name="TerminalBox"
                                        Background="#171717" Foreground="#E6E6E6"
                                        CaretBrush="#E6E6E6" BorderThickness="0"
                                        Padding="14,12" FontFamily="monospace" FontSize="13"
                                        TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True"
                                        IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="EmptyHint"
                           Margin="24"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="Start a conversation from the sidebar."/>
                <TextBlock x:Name="WorkingIndicator"
                           Margin="24,0,24,8"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           IsVisible="False"/>
                <ItemsControl x:Name="Messages" Margin="24,8,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,20">
                                <StackPanel>
<Grid>
                                    <StackPanel IsVisible="{Binding Kind, Converter={x:Static views:NotPlanVisibility.Instance}}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Kind, Converter={x:Static views:KindLabel.Instance}}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="…" HorizontalAlignment="Right"
                                                       IsVisible="{Binding Streaming}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding ContextRootIds, Converter={x:Static views:ContextRootLabel.Instance}}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding ., Converter={x:Static views:RunSummaryLabel.Instance}}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   IsVisible="{Binding ., Converter={x:Static views:RunSummaryVisibility.Instance}}"/>
                                        <Image MaxWidth="520" MaxHeight="520" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,8,0,0"
                                               Source="{Binding Media.FilePath, Converter={x:Static views:AttachmentImage.Instance}}"/>
                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="64" Height="64" Stretch="UniformToFill"
                                                                   Source="{Binding FilePath, Converter={x:Static views:AttachmentImage.Instance}}"
                                                                   IsVisible="{Binding IsImage}"/>
                                                            <StackPanel Width="170" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Expander IsExpanded="False" Margin="0,8,0,0"
                                                  Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.used}"
                                                  IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=used}">
                                                <StackPanel Margin="8,6,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.skills}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <ItemsControl ItemsSource="{Binding UsedSkills}">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                           Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.tools}"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                <ItemsControl ItemsSource="{Binding UsedTools}">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"/>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Expander>
                                        <Expander Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.changedFiles}" IsExpanded="False" Margin="0,6,0,0"
                                                  IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=files}">
                                            <ItemsControl ItemsSource="{Binding ChangedFiles}" Margin="8,6,0,0">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimary}"
                                                               AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"/>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                    <Border IsVisible="{Binding Kind, Converter={x:Static views:PlanVisibility.Instance}}"
                                            BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="10"
                                            Padding="12" Background="{DynamicResource PanelBackground}">
                                        <StackPanel>
                                            <DockPanel LastChildFill="False">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💡" Margin="0,0,6,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                               Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.plan}"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                </StackPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding ., Converter={x:Static views:PlanStatus.Instance}}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,10,0,10"
                                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding ., Converter={x:Static views:RunSummaryLabel.Instance}}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       IsVisible="{Binding ., Converter={x:Static views:RunSummaryVisibility.Instance}}"/>
                                            <Expander Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.used}" IsExpanded="False" Margin="0,0,0,6"
                                                      IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=used}">
                                                <StackPanel Margin="8,6,0,0">
                                                    <TextBlock Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.skills}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding UsedSkills}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.tools}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding UsedTools}">
                                                        <ItemsControl.ItemTemplate><DataTemplate>
                                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                        </DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Expander>
                                        <Expander IsExpanded="False" Margin="0,0,0,6"
                                                  Header="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.changedFiles}"
                                                  IsVisible="{Binding ., Converter={x:Static views:MetadataVisibility.Instance}, ConverterParameter=files}">
                                                <ItemsControl ItemsSource="{Binding ChangedFiles}" Margin="8,6,0,0">
                                                    <ItemsControl.ItemTemplate><DataTemplate>
                                                        <TextBlock Text="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   AutomationProperties.Name="{Binding ., Converter={x:Static views:ChangedFileLabel.Instance}}"/>
                                                    </DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.applyPlan}" Tag="{Binding}" Click="OnApplyPlan"
                                                    IsVisible="{Binding IsPendingPlan}"
                                                    IsEnabled="{Binding CanApplyPlan}" HorizontalAlignment="Left"
                                                    Padding="12,5" ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.applyPlanHelp}"
                                                    AutomationProperties.Name="Apply plan"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Opacity="0.7" IsVisible="{Binding ., Converter={x:Static views:MessageActionsVisibility.Instance}}">
                                        <Button Tag="{Binding}" Click="OnCopyMessage" Padding="4" Background="Transparent" BorderThickness="0"
                                                AutomationProperties.Name="Copy" ToolTip.Tip="Copy">
                                            <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" Width="15" Height="15"/>
                                        </Button>
                                        <TextBlock Text="{Binding CreatedAt, Converter={x:Static views:RelativeTime.Instance}}" FontSize="13" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl x:Name="PendingMessages" Margin="24,0,24,24">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="12" CornerRadius="12"
                                    Background="{DynamicResource BubbleUser}" Opacity="0.72">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steer}" Tag="{Binding}" Click="OnSteerPending"
                                                    IsVisible="{Binding Mode, Converter={x:Static views:PromptModeSteerVisibility.Instance}}"
                                                    Padding="10,2" Margin="8,0,0,0"
                                                    ToolTip.Tip="{Binding Converter={x:Static views:LocalizedCopy.Instance}, ConverterParameter=conversation.steerHelp}"/>
                                            <TextBlock Text="{Binding Placement, Converter={x:Static views:PromptPlacementLabel.Instance}}"
                                                       VerticalAlignment="Center" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Mode, Converter={x:Static views:PromptModeLabel.Instance}}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource PanelBackground}" CornerRadius="8" Padding="6" Margin="0,0,8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Image Width="64" Height="64" Stretch="UniformToFill"
                                                               Source="{Binding FilePath, Converter={x:Static views:AttachmentImage.Instance}}"
                                                               IsVisible="{Binding IsImage}"/>
                                                        <StackPanel Width="170" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
