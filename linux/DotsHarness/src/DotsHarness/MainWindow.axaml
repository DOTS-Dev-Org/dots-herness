<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:DotsHarnessCore"
        xmlns:views="using:DotsHarness.Views"
        x:Class="DotsHarness.MainWindow"
        x:DataType="core:AppModel"
        Icon="avares://DotsHarness/Resources/DotsHarness.ico"
        Title="Dots Harness"
        MinWidth="640" MinHeight="520"
        Width="1180" Height="760"
        SizeChanged="OnWindowSizeChanged"
        Background="{DynamicResource WindowBackground}">
    <Grid RowDefinitions="44,*">
        <Border Grid.Row="0" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button x:Name="TasksButton" Content="Tasks" Padding="10,4" Margin="0,8,6,8"
                            Click="OnTasks" ToolTip.Tip="Scheduled tasks"/>
                    <Button x:Name="PaneButton" Content="Panels" Padding="10,4" Margin="0,8,0,8"
                            Click="OnPanePicker" ToolTip.Tip="Open a side panel"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="SidebarToggle" Content="☰" Width="30" Height="28" Padding="0"
                            Click="OnToggleSidebar" ToolTip.Tip="Show or hide sidebar"/>
                    <TextBlock x:Name="WindowTitle" Text="DOTS Harness" Margin="10,0,0,0"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimary}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="68,*">
        <Border Grid.Column="0" Background="{DynamicResource ChromeBackground}"
                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel x:Name="Rail" LastChildFill="False" Margin="0,6,0,10"/>
        </Border>
        <ContentControl x:Name="SectionHost" Grid.Column="1" IsVisible="False"/>
        <Grid x:Name="DesktopGrid" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="250" MaxWidth="340"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0" MinWidth="0"/>
            </Grid.ColumnDefinitions>
            <views:SidebarView x:Name="Sidebar" Grid.Column="0"/>
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False"/>
            <Grid x:Name="DetailHost" Grid.Column="2" Background="{DynamicResource PanelBackground}">
                <views:ConversationView x:Name="Conversation"/>
            </Grid>
            <GridSplitter x:Name="DockSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderSubtle}"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" IsVisible="False"/>
            <views:RightDockView x:Name="RightDock" Grid.Column="4" IsVisible="False"/>
            <Button x:Name="CompactScrim" Grid.Column="0" Grid.ColumnSpan="5"
                    ZIndex="10" IsVisible="False" Focusable="False"
                    Background="#66000000" BorderThickness="0" Padding="0"
                    Click="OnDismissCompactSidebar"/>
            <views:SlotHost x:Name="OverlayHost" Grid.Column="0" Grid.ColumnSpan="5"
                            ZIndex="20" IsHitTestVisible="True"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
