<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>DotsHarness</RootNamespace>
    <AssemblyName>DotsHarness</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.8" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.8" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Boyut: Linux'ta yalnız X11 yüklenir; Avalonia.Desktop'un çektiği Win32/macOS DLL'leri pakete girmesin. -->
    <PackageReference Include="Avalonia.Win32" Version="11.2.8" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia.Native" Version="11.2.8" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HarnessPluginKit\HarnessPluginKit.csproj" />
    <ProjectReference Include="..\PluginRuntime\PluginRuntime.csproj" />
    <ProjectReference Include="..\DotsHarnessCore\DotsHarnessCore.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\DotsHarness.ico" />
    <AvaloniaResource Include="Resources\DotsHarness.png" />
    <AvaloniaResource Include="Resources\TrayIcon.png" />
    <AvaloniaResource Include="Resources\ProviderMarks\*.png" />
    <AvaloniaResource Include="Resources\HerNessLoaderFrame*.png" />
    <AvaloniaResource Include="Resources\presets\host.yml" />
    <Content Include="Resources\skills\**\*" TargetPath="Resources\skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Cross-platform skills live once in shared/skills; only platform-specific ones stay in Resources\skills. -->
    <Content Include="..\..\..\..\shared\skills\**\*" Link="Resources\skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\skillsmp-popular-200.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
