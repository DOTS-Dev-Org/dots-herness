"composer.cacheExpired.explanation" = "கேச்சின் மதிப்பிடப்பட்ட ஆயுட்காலம் முடிந்துவிட்டது. ப்ராம்ப்ட் கேச் என்பது வழங்குநர் பக்கத்திலுள்ள தற்காலிகச் செயலாக்க நிலை; உங்கள் அரட்டை வரலாறு சேமிக்கப்பட்டே இருக்கும். முழு வரலாற்றுடன் தொடர்ந்தால், அந்த டோக்கன்கள் மீண்டும் புதிய உள்ளீடாகக் கணக்கிடப்படலாம். வழங்குநரிடம் கேச் இன்னும் இருந்ததா என்பதை அடுத்த கோரிக்கையின் பயன்பாட்டுத் தரவிலிருந்தே உறுதிப்படுத்த முடியும்.";
