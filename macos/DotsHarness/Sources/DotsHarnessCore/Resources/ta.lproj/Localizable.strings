/* Welcome screen (new-chat empty state) */
"welcome.heading" = "%@-இல் எதில் பணியாற்றலாம்?";
"welcome.connectHint" = "தொடங்க, அமைப்புகளில் ஒரு மாதிரியை இணைக்கவும். அட்டையைத் தட்டினால் அறிவுறுத்தல் புலம் மட்டுமே நிரம்பும்—எதுவும் அனுப்பப்படாது.";
