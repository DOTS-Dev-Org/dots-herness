"welcome.card.explore.prompt" = "%@-இன் கட்டமைப்பை ஆராய்ந்து விளக்கவும். முக்கிய தொகுதிகள், நுழைவுப் புள்ளிகள் மற்றும் அவற்றுக்கிடையேயான தரவு ஓட்டத்தை வரைபடமிட்டு, பின்னர் கண்டவற்றைச் சுருக்கவும்.";
"welcome.card.build.title" = "ஏதாவது உருவாக்கு";
