"welcome.card.fix.subtitle" = "சிக்கல்களைக் கண்டறிந்து தீர்க்கவும்";
"welcome.card.fix.prompt" = "%@-இல் உள்ள பிழையை ஆராயவும். அறிகுறிகளையும் மீண்டும் உருவாக்கும் படிகளையும் கேட்டு, மூல காரணத்தைக் கண்டறிந்து, குறைந்தபட்ச தெளிவான திருத்தத்தை முன்மொழியவும்.";
