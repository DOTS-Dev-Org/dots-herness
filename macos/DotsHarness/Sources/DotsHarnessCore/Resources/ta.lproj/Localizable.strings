"welcome.card.build.prompt" = "%@-இல் புதிய அம்சத்தை உருவாக்க எனக்கு உதவுங்கள். அது என்ன செய்ய வேண்டும் என்று கேட்டு, தற்போதைய நடைமுறைகளுக்கும் விதிகளுக்கும் பொருந்தும் அணுகுமுறையை முன்மொழிந்து, பின்னர் செயல்படுத்தவும்.";
"welcome.card.review.title" = "குறியீட்டை மதிப்பாய்வு செய்யவும்";
"welcome.card.review.subtitle" = "கருத்தும் குறிப்பான பரிந்துரைகளும் பெறுங்கள்";
"welcome.card.review.prompt" = "%@-இன் சமீபத்திய மாற்றங்களைச் சரியானதா, எல்லை நிலைகளா, பாணியா என மதிப்பாய்வு செய்யவும். தெளிவான சிக்கல்களைச் சுட்டி குறிப்பான மேம்பாடுகளைப் பரிந்துரைக்கவும்.";
