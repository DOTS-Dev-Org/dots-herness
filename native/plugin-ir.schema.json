{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dots.net.tr/harness/plugin-ir.schema.json",
  "title": "DOTS Native Plugin IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "prompt", "tools", "events", "settings", "panels"],
  "properties": {
    "version": { "const": 1 },
    "prompt": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "order", "text"],
        "properties": {
          "name": { "type": "string", "maxLength": 120 },
          "order": { "type": "integer", "minimum": -10000, "maximum": 10000 },
          "text": { "type": "string", "maxLength": 20000 }
        }
      }
    },
    "tools": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "parameters"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,119}$" },
          "description": { "type": "string", "maxLength": 2000 },
          "parameters": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "description", "required"],
              "properties": {
                "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.-]{0,63}$" },
                "type": { "enum": ["string", "number", "boolean", "object", "array"] },
                "description": { "type": "string", "maxLength": 500 },
                "required": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:/-]{0,119}$" },
          "direction": { "enum": ["listen", "emit", "both"] }
        }
      }
    },
    "settings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_.:-]{0,119}$" },
          "type": { "enum": ["string", "number", "boolean", "object", "array"] },
          "default": {}
        }
      }
    },
    "panels": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "id", "order", "label", "body"],
        "properties": {
          "slot": { "enum": ["conversation.composer.accessory", "shell.overlay", "settings.sections", "plugins.detail", "shell.sidebar.footer"] },
          "id": { "type": "string", "maxLength": 120 },
          "order": { "type": "integer", "minimum": -10000, "maximum": 10000 },
          "label": { "type": "string", "maxLength": 200 },
          "body": { "$ref": "#/$defs/panelNode" }
        }
      }
    }
  },
  "$defs": {
    "panelNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["vstack", "hstack", "text", "button", "field", "toggle", "spacer", "image"] },
        "id": { "type": "string", "maxLength": 120 },
        "label": { "type": "string", "maxLength": 200 },
        "text": { "type": "string", "maxLength": 2000 },
        "key": { "type": "string", "maxLength": 120 },
        "placeholder": { "type": "string", "maxLength": 200 },
        "tool": { "type": "string", "maxLength": 120 },
        "args": { "type": "object", "additionalProperties": { "type": "string" } },
        "children": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/panelNode" } }
      }
    }
  }
}
