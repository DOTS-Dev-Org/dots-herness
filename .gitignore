.DS_Store

# Build and package output
**/.build/
**/.swiftpm/
**/dist/
**/bin/
**/obj/
*.xcodeproj

# Local editor and environment files
.commandcode/
.idea/
.vscode/
*.env
*.env.*
!.env.example
**/.dev.vars
**/__pycache__/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/app/.cxx/
mobile/ios/build/

# Android signing material and local Gradle properties must stay out of Git.
**/keystore.properties
**/gradle.properties
**/local.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/google-services.json
**/.smoke-credentials.local
**/d1_dump*.sql

# Raw user feedback is local training data; derived project memory stays tracked.
**/.mem/feedback.jsonl
**/.mem/injections.jsonl
