.DS_Store

# Build and package output
**/.build/
**/.swiftpm/
**/dist/
**/bin/
**/obj/
*.xcodeproj

# Local editor and environment files
.commandcode/
.idea/
.vscode/
*.env
*.env.*
!.env.example
**/.dev.vars
**/__pycache__/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/app/.cxx/
mobile/ios/build/

# Android signing material and local Gradle properties must stay out of Git.
**/keystore.properties
**/gradle.properties
**/local.properties
**/*.jks
**/*.keystore
**/*.p12
**/*.pem
**/google-services.json
**/.smoke-credentials.local
**/d1_dump*.sql

# A person's memory lives in the user layer on their Mac (app support), never in the
# repository. Project memory - the manifest, facts.md (project facts and decisions), the
# legacy signed events and the map - stays tracked.
# These stay ignored in case an older build writes them into the repository.
**/.mem/tasks/
**/.mem/conversations/
**/.mem/feedback.jsonl
**/.mem/injections.jsonl
**/.mem/gold_examples.json
**/.mem/lessons.json
**/.mem/learned_rules.md
**/.mem/preferences.md
# Derived from the signed events on every load; a committed copy only conflicts.
**/.mem/state.json
**/.mem/code-graph/

.wrangler/
.sandbox-cache/
